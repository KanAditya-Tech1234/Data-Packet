# Copy this file to .env for local runs. Never commit .env (it is in .gitignore).

# Required: your MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name inside the cluster.
MONGODB_DB=drone_packets

# Port for local runs (Render sets PORT itself).
PORT=3000

# Signs the login cookies. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value

# Keep at most this many packets; the oldest are deleted automatically.
MAX_PACKETS=500

# Firmware (thrust bench): mobile numbers that are always firmware admins (comma-separated).
ADMIN_PHONES=

# Largest firmware image per target in bytes = the OTA app slot of its partition scheme (ask the firmware owner).
# TB_MAX_APP_SIZE_MAIN=1966080
# TB_MAX_APP_SIZE_N1=1310720
# TB_MAX_APP_SIZE_N2=1310720

# Only for `npm test`: run the tests against a real MongoDB (a separate database is created and dropped).
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
