{
  "info": {
    "name": "Drone Tag – Data Packets",
    "description": "Set the environment variable baseUrl (e.g. http://localhost:3000 or your Render URL). For the Firmware requests also set tbToken: an API token from the Users and API tokens page (/access).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('database connected', () => pm.expect(j.database).to.eql('connected'));",
              "pm.test('status ok', () => pm.expect(j.status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Send one packet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('status ok', () => pm.expect(j.status).to.eql('ok'));",
              "pm.test('has packetId and seq', () => { pm.expect(j.packetId).to.be.a('string'); pm.expect(j.seq).to.be.a('number'); });",
              "pm.collectionVariables.set('lastSeq', j.seq);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"1005\",\n  \"lat\": 23.078143,\n  \"lon\": 72.531243,\n  \"Alt\": 16.5,\n  \"Alt_R\": \"AGL\",\n  \"d_x\": 0.32,\n  \"d_y\": -0.18,\n  \"d_z\": 0.19\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/packet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "packet"
          ]
        }
      }
    },
    {
      "name": "Send a batch of 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('count is 3', () => pm.expect(j.count).to.eql(3));",
              "pm.test('3 packet ids', () => pm.expect(j.packetIds).to.have.lengthOf(3));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"id\": \"1005\",\n    \"lat\": 23.078143,\n    \"lon\": 72.531243,\n    \"Alt\": 16.5,\n    \"Alt_R\": \"AGL\",\n    \"d_x\": 0.32,\n    \"d_y\": -0.18,\n    \"d_z\": 0.19\n  },\n  {\n    \"id\": \"1005\",\n    \"lat\": 23.078201,\n    \"lon\": 72.531302,\n    \"Alt\": 17.1,\n    \"Alt_R\": \"AGL\",\n    \"d_x\": 0.32,\n    \"d_y\": -0.18,\n    \"d_z\": 0.19\n  },\n  {\n    \"id\": \"1005\",\n    \"lat\": 23.078262,\n    \"lon\": 72.531366,\n    \"Alt\": 17.6,\n    \"Alt_R\": \"AGL\",\n    \"d_x\": 0.32,\n    \"d_y\": -0.18,\n    \"d_z\": 0.19\n  }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/packet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "packet"
          ]
        }
      }
    },
    {
      "name": "Read one drone (1005)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('packets of drone 1005 only', () => { pm.expect(j.packets.length).to.be.above(0); j.packets.forEach(p => pm.expect(p.trackerId.toLowerCase()).to.eql('1005')); });",
              "pm.test('oldest first', () => { for (let i = 1; i < j.packets.length; i++) pm.expect(j.packets[i].seq).to.be.above(j.packets[i-1].seq); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/packet/1005?limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "packet",
            "1005"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Read all drones",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('has packets, trackers and seq', () => { pm.expect(j.packets).to.be.an('array'); pm.expect(j.trackers).to.include('1005'); pm.expect(j.seq).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/packet?limit=200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "packet"
          ],
          "query": [
            {
              "key": "limit",
              "value": "200"
            }
          ]
        }
      }
    },
    {
      "name": "Invalid packet (expects 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const j = pm.response.json();",
              "pm.test('error JSON', () => { pm.expect(j.status).to.eql('error'); pm.expect(j.errors).to.be.an('array').that.is.not.empty; });",
              "pm.test('lists both problems', () => { pm.expect(j.errors.join(' ')).to.include('lat must be between'); pm.expect(j.errors.join(' ')).to.include('lon is required'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"1005\",\n  \"lat\": 123.4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/packet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "packet"
          ]
        }
      }
    },
    {
      "name": "Sensors: list",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has a sensors list', () => pm.expect(pm.response.json().sensors).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sensors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sensors"
          ],
          "query": []
        }
      }
    },
    {
      "name": "Sensor config: check version",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, or 404 for an unknown sensor / no file yet', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
              "if (pm.response.code === 200) { const j = pm.response.json(); pm.test('exactly status, updateAvailable, version, fileName, contentType', () => pm.expect(Object.keys(j)).to.eql(['status', 'updateAvailable', 'version', 'fileName', 'contentType'])); pm.test('updateAvailable is true/false', () => pm.expect(j.updateAvailable).to.be.a('boolean')); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sensors/{{sensorId}}/config/version?current=1.0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sensors",
            "{{sensorId}}",
            "config",
            "version"
          ],
          "query": [
            {
              "key": "current",
              "value": "1.0"
            }
          ]
        }
      }
    },
    {
      "name": "Sensor config: download latest",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, or 404 for an unknown sensor / no file yet', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
              "if (pm.response.code === 200) pm.test('has the version header', () => pm.expect(pm.response.headers.get('X-Config-Version')).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sensors/{{sensorId}}/config/download",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sensors",
            "{{sensorId}}",
            "config",
            "download"
          ],
          "query": []
        }
      }
    },
    {
      "name": "Firmware: latest n1 (stable)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, or 404 when there is no stable n1 yet', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
              "if (pm.response.code === 200) { const m = pm.response.json(); pm.test('lower-case md5', () => pm.expect(m.md5).to.match(/^[0-9a-f]{32}$/)); pm.collectionVariables.set('releaseId', m.release_id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tbToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/tb/v1/firmware/latest?target=n1&channel=stable",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tb",
            "v1",
            "firmware",
            "latest"
          ],
          "query": [
            {
              "key": "target",
              "value": "n1"
            },
            {
              "key": "channel",
              "value": "stable"
            }
          ]
        }
      }
    },
    {
      "name": "Firmware: list (all targets, with yanked)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('array of manifests', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tbToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/tb/v1/firmware?include_yanked=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tb",
            "v1",
            "firmware"
          ],
          "query": [
            {
              "key": "include_yanked",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "Firmware: compatible set",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, or 404 when no compatible set exists', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
              "if (pm.response.code === 200) pm.test('main, n1, n2', () => pm.expect(pm.response.json()).to.have.all.keys('main', 'n1', 'n2'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tbToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/tb/v1/firmware/compatible-set?channel=stable",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tb",
            "v1",
            "firmware",
            "compatible-set"
          ],
          "query": [
            {
              "key": "channel",
              "value": "stable"
            }
          ]
        }
      }
    },
    {
      "name": "Firmware: manifest.json of {{releaseId}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('ETag is the sha256', () => pm.expect(pm.response.headers.get('ETag')).to.match(/^\"[0-9a-f]{64}\"$/));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tbToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/tb/v1/firmware/{{releaseId}}/manifest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tb",
            "v1",
            "firmware",
            "{{releaseId}}",
            "manifest"
          ],
          "query": []
        }
      }
    },
    {
      "name": "Firmware: download .tbfw of {{releaseId}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 zip', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/zip'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tbToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/tb/v1/firmware/{{releaseId}}/package",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tb",
            "v1",
            "firmware",
            "{{releaseId}}",
            "package"
          ],
          "query": []
        }
      }
    },
    {
      "name": "Firmware: first 1 KB of the .bin (Range)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('206 partial', () => pm.response.to.have.status(206));",
              "pm.test('Content-Range', () => pm.expect(pm.response.headers.get('Content-Range')).to.match(/^bytes 0-1023\\//));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Range",
            "value": "bytes=0-1023"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tbToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/tb/v1/firmware/{{releaseId}}/bin",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tb",
            "v1",
            "firmware",
            "{{releaseId}}",
            "bin"
          ],
          "query": []
        }
      }
    },
    {
      "name": "Firmware: without token (expects 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 unauthorized', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().error).to.equal('unauthorized'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tb/v1/firmware",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tb",
            "v1",
            "firmware"
          ],
          "query": []
        }
      }
    }
  ],
  "variable": [
    {
      "key": "lastSeq",
      "value": "0"
    },
    {
      "key": "sensorId",
      "value": "node-sensor"
    },
    {
      "key": "releaseId",
      "value": ""
    }
  ]
}
